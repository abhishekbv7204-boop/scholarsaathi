# GEMINI_API_KEY: Optional if using Gemini for assistant explanations.
GEMINI_API_KEY=

# APP_URL: Base URL for web hosting and callbacks
APP_URL=

# PORT & Node Environment
PORT=3000
NODE_ENV=development

# Optional Amazon Bedrock Configuration (when deployed on AWS Lambda)
USE_AWS_BEDROCK=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
